<view class="home-view">
  <!-- 图标墙 -->
  <view class="icons-wall">
    <block wx:for="{{icons}}" wx:key="id">
      <view
        class="zine-item"
        data-id="{{item.id}}"
        style="left: {{item._x}}px; top: {{item._y}}px; width: {{item._w}}px;"
        bindtap="onIconTap"
      >
        <view class="zine-icon-btn" style="width: {{item._bw}}px; height: {{item._bh}}px;">
          <image
            wx:if="{{item.iconDataURL}}"
            class="zine-icon-img"
            src="{{item.iconDataURL}}"
            mode="aspectFill"
          />
          <view wx:else class="zine-placeholder">
            <text>{{item.title ? item.title.slice(0,2) : 'Z'}}</text>
          </view>
        </view>
        <text class="zine-name">{{item.title || '未命名'}}</text>
      </view>
    </block>
  </view>

  <!-- 中央制作按钮 -->
  <button class="circle-btn primary home-enter-btn" bindtap="onEnter">现在，设计你的ZINE</button>

  <!-- 右上角工具 -->
  <view class="top-tools">
    <button class="circle-btn small" bindtap="onRefresh">↻ 刷新</button>
    <button class="circle-btn small" bindtap="onSearchTap">🔍 搜索</button>
  </view>

  <!-- 左下角管理员 -->
  <view class="login-entry {{admin ? 'authed' : ''}}" bindtap="onLoginTap"></view>

  <!-- 搜索页 -->
  <view class="search-page" wx:if="{{showSearch}}">
    <view class="search-top">
      <view class="search-row">
        <input
          class="search-input"
          value="{{searchQuery}}"
          bindinput="onSearchInput"
          bindconfirm="onSearch"
          placeholder="搜索 ZINE 名称…"
          focus="{{true}}"
          confirm-type="search"
        />
        <button class="circle-btn small" bindtap="onSearchCancel">取消</button>
      </view>
    </view>
    <scroll-view class="search-results" scroll-y wx:if="{{searchResults.length}}">
      <view
        wx:for="{{searchResults}}" wx:key="id"
        class="search-item" bindtap="onSearchItemTap" data-id="{{item.id}}"
      >
        <image wx:if="{{item.iconDataURL}}" class="search-thumb" src="{{item.iconDataURL}}" mode="aspectFill" />
        <view wx:else class="search-thumb-bg"><text>{{item.title ? item.title.slice(0,2) : 'Z'}}</text></view>
        <view class="search-info">
          <text class="search-title">{{item.title || '未命名'}}</text>
          <text class="search-pages" wx:if="{{item.pageCount}}">{{item.pageCount}} 页</text>
        </view>
      </view>
    </scroll-view>
    <view class="search-empty" wx:if="{{searchDone && !searchResults.length}}">
      <text>未找到匹配的 ZINE</text>
      <button class="circle-btn small" bindtap="onSearchCancel">返回</button>
    </view>
  </view>

  <!-- 登录弹窗 -->
  <view class="login-modal {{showLogin ? '' : 'hidden'}}" catchtap="onCancelLogin">
    <view class="login-card" catchtap="stopProp">
      <view class="login-title">管理员登录</view>
      <view class="login-field">
        <text class="login-label">账号</text>
        <input class="login-input" value="{{loginUser}}" bindinput="onUserInput" placeholder="账号" />
      </view>
      <view class="login-field">
        <text class="login-label">密码</text>
        <input class="login-input" value="{{loginPass}}" bindinput="onPassInput" password placeholder="密码" />
      </view>
      <view class="login-actions">
        <button class="circle-btn primary" bindtap="onLoginSubmit">登录</button>
        <button class="circle-btn" bindtap="onCancelLogin">取消</button>
      </view>
    </view>
  </view>

  <view class="status-bar" wx:if="{{status}}">{{status}}</view>
</view>
