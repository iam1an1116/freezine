<view class="home-view">
  <canvas
    type="2d"
    id="physicsCanvas"
    class="physics-canvas"
    bindtap="onCanvasTap"
  ></canvas>

  <!-- 搜索栏（在 canvas 上方，canvas 内绘制搜索输入框受限，所以单独放） -->
  <cover-view class="search-bar {{showSearch ? '' : 'hidden'}}">
    <cover-view class="search-row">
      <input
        class="search-input"
        value="{{searchQuery}}"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
        placeholder="搜索 ZINE…"
        focus="{{showSearch}}"
      />
      <cover-view class="circle-btn small search-cancel" bindtap="onSearchCancel">取消</cover-view>
    </cover-view>
  </cover-view>

  <!-- 登录弹窗（全屏遮罩，canvas 在下面不影响） -->
  <view class="login-modal {{showLogin ? '' : 'hidden'}}" catchtap="onCancelLogin">
    <view class="login-card" catchtap="stopProp">
      <view class="login-title">管理员登录</view>
      <view class="login-field">
        <text class="login-label">账号</text>
        <input class="login-input" value="{{loginUser}}" bindinput="onUserInput" placeholder="账号" />
      </view>
      <view class="login-field">
        <text class="login-label">密码</text>
        <input class="login-input" value="{{loginPass}}" bindinput="onPassInput" password placeholder="密码" />
      </view>
      <view class="login-actions">
        <button class="circle-btn primary" bindtap="onLoginSubmit">登录</button>
        <button class="circle-btn" bindtap="onCancelLogin">取消</button>
      </view>
    </view>
  </view>

  <cover-view class="status-bar" wx:if="{{status}}">{{status}}</cover-view>
</view>
