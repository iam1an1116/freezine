/* Canvas 物理引擎首页 */
.home-view {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #fff;
}

.physics-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.home-enter-btn {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  z-index: 5;
  pointer-events: auto;
}

.login-entry {
  position: fixed;
  bottom: 28rpx;
  left: 28rpx;
  z-index: 60;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: rgba(15,23,42,.22);
}
.login-entry.authed {
  background: rgba(15,23,42,.92);
}

.login-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 70;
  background: rgba(255,255,255,.92);
  display: flex;
  align-items: center;
  justify-content: center;
}
.login-card {
  width: 640rpx;
  border: 1px solid #e5e7eb;
  border-radius: 18px;
  background: #fff;
  padding: 36rpx 32rpx;
  box-shadow: 0 16px 60px rgba(15,23,42,.08);
}
.login-title {
  font-weight: 950;
  font-size: 32rpx;
  margin-bottom: 24rpx;
}
.login-field {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 20rpx 0;
}
.login-label {
  width: 80rpx;
  font-weight: 650;
  flex-shrink: 0;
}
.login-input {
  flex: 1;
  border: 1px solid #e5e7eb;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}
.login-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
  justify-content: flex-end;
}

.status-bar {
  position: fixed;
  bottom: 100rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 80;
  background: rgba(15,23,42,.85);
  color: #fff;
  padding: 16rpx 36rpx;
  border-radius: 999px;
  font-size: 24rpx;
}
