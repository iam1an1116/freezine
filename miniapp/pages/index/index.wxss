/* 首页 */
.home-view {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #fff;
}

/* 图标墙 */
.icons-wall {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.zine-item {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  max-width: 132px;
}

.zine-icon-btn {
  border-radius: 16px;
  border: 1px solid rgba(15,23,42,.1);
  background: #fff;
  overflow: hidden;
  box-shadow: 0 8px 28px rgba(15,23,42,.08), 0 1px 0 rgba(255,255,255,.9) inset;
}

.zine-icon-img {
  display: block;
}

.zine-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(79,70,229,.12), rgba(124,92,255,.18));
  border-radius: 16px;
}
.zine-placeholder-text {
  font-size: 32rpx;
  font-weight: 950;
  color: rgba(79,70,229,.55);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 80%;
}

.zine-name {
  margin-top: 10px;
  max-width: 120px;
  text-align: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #111827;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 进入按钮 */
.home-enter-btn {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  z-index: 5;
  pointer-events: auto;
}

/* 管理员入口 */
.login-entry {
  position: fixed;
  bottom: 28rpx;
  left: 28rpx;
  z-index: 60;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: rgba(15,23,42,.22);
}
.login-entry.authed {
  background: rgba(15,23,42,.92);
}

/* 登录弹窗 */
.login-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 70;
  background: rgba(255,255,255,.92);
  display: flex;
  align-items: center;
  justify-content: center;
}
.login-card {
  width: 640rpx;
  border: 1px solid #e5e7eb;
  border-radius: 18px;
  background: #fff;
  padding: 36rpx 32rpx;
  box-shadow: 0 16px 60px rgba(15,23,42,.08);
}
.login-title {
  font-weight: 950;
  font-size: 32rpx;
  margin-bottom: 24rpx;
}
.login-field {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 20rpx 0;
}
.login-label {
  width: 80rpx;
  font-weight: 650;
  flex-shrink: 0;
}
.login-input {
  flex: 1;
  border: 1px solid #e5e7eb;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}
.login-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
  justify-content: flex-end;
}

/* 状态 */
.status-bar {
  position: fixed;
  bottom: 100rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 80;
  background: rgba(15,23,42,.85);
  color: #fff;
  padding: 16rpx 36rpx;
  border-radius: 999px;
  font-size: 24rpx;
}
