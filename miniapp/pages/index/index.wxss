.home-view {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #f1f5f9;
}

.physics-canvas {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
}

/* 搜索栏 (cover-view) */
.search-bar {
  position: absolute;
  top: 0; left: 0; right: 0;
  z-index: 10;
  background: rgba(255,255,255,.96);
  padding: 20rpx 24rpx;
}
.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.search-input {
  flex: 1;
  border: 1px solid #e5e7eb;
  border-radius: 999px;
  padding: 16rpx 28rpx;
  font-size: 28rpx;
  background: #f8fafc;
  height: 36px;
}
.search-cancel {
  flex-shrink: 0;
}

/* 登录弹窗 */
.login-modal {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  z-index: 70;
  background: rgba(255,255,255,.94);
  display: flex;
  align-items: center;
  justify-content: center;
}
.login-card {
  width: 640rpx;
  border: 1px solid #e5e7eb;
  border-radius: 18px;
  background: #fff;
  padding: 36rpx 32rpx;
  box-shadow: 0 16px 60px rgba(15,23,42,.08);
}
.login-title { font-weight: 950; font-size: 32rpx; margin-bottom: 24rpx; }
.login-field { display: flex; align-items: center; gap: 24rpx; margin: 20rpx 0; }
.login-label { width: 80rpx; font-weight: 650; flex-shrink: 0; }
.login-input { flex: 1; border: 1px solid #e5e7eb; border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 28rpx; }
.login-actions { display: flex; gap: 20rpx; margin-top: 28rpx; justify-content: flex-end; }

.status-bar {
  position: fixed;
  bottom: 100rpx; left: 50%;
  transform: translateX(-50%);
  z-index: 80;
  background: rgba(15,23,42,.85);
  color: #fff;
  padding: 16rpx 36rpx;
  border-radius: 999px;
  font-size: 24rpx;
}
