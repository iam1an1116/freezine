.home-view { position:relative; width:100vw; height:100vh; overflow:hidden; background:#f1f5f9; }
.physics-canvas { position:absolute; top:0; left:0; width:100%; height:100%; }

.search-page { position:fixed; top:0; left:0; width:100%; height:100%; z-index:50; background:#fff; display:flex; flex-direction:column; }
.search-top { padding:20rpx 24rpx; border-bottom:1px solid #f1f5f9; }
.search-row { display:flex; align-items:center; gap:12rpx; }
.search-input { flex:1; border:1px solid #e5e7eb; border-radius:999px; padding:16rpx 24rpx; font-size:28rpx; background:#f8fafc; }
.search-results { flex:1; padding:16rpx 24rpx; }
.search-item { display:flex; align-items:center; gap:20rpx; padding:20rpx 0; border-bottom:1px solid #f5f5f5; }
.search-thumb { width:72rpx; height:72rpx; border-radius:12rpx; background:#f1f5f9; }
.search-thumb-bg { width:72rpx; height:72rpx; border-radius:12rpx; background:rgba(79,70,229,.08); display:flex; align-items:center; justify-content:center; font-weight:700; color:rgba(79,70,229,.5); font-size:24rpx; }
.search-info { flex:1; }
.search-title { font-weight:700; font-size:28rpx; color:#111827; }
.search-pages { font-size:22rpx; color:#94a3b8; display:block; }
.search-empty { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:28rpx; color:#94a3b8; font-size:28rpx; }


.status-bar { position:fixed; bottom:100rpx; left:50%; transform:translateX(-50%); z-index:80; background:rgba(15,23,42,.85); color:#fff; padding:16rpx 36rpx; border-radius:999px; font-size:24rpx; }
