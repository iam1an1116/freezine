page { background:#1e1e2e; color:#fff; height:100%; }
.page { display:flex; flex-direction:column; height:100vh; }

.bar { display:flex; align-items:center; gap:6rpx; padding:8rpx 12rpx; flex-wrap:wrap; background:rgba(30,30,46,.95); }
.top-bar { border-bottom:1px solid rgba(255,255,255,.08); padding-top:calc(8rpx + env(safe-area-inset-top)); }
.bottom-bar { border-top:1px solid rgba(255,255,255,.08); padding-bottom:calc(8rpx + env(safe-area-inset-bottom)); justify-content:center; }

.b { color:#cdd6f4; font-size:22rpx; padding:8rpx 14rpx; border-radius:6rpx; background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.1); line-height:1; white-space:nowrap; margin:0; }
.b:active { background:rgba(255,255,255,.18); }
.b.primary { background:#6366f1; border-color:#6366f1; color:#fff; }

.info { font-size:22rpx; color:rgba(255,255,255,.6); margin:0 8rpx; white-space:nowrap; }

.canvas-area { flex:1; display:flex; align-items:center; justify-content:center; overflow:hidden; }
.ec { width:100%; height:100%; }

/* Modals */
.modal { position:fixed; top:0; left:0; width:100%; height:100%; z-index:100; background:rgba(0,0,0,.6); display:flex; align-items:center; justify-content:center; }
.modal-card { background:#2a2a3e; border-radius:16rpx; padding:32rpx; width:640rpx; max-height:80vh; overflow-y:auto; }
.modal-title { font-weight:900; font-size:30rpx; margin-bottom:20rpx; text-align:center; color:#cdd6f4; }
.modal-item { font-size:28rpx; padding:18rpx 24rpx; border-bottom:1px solid rgba(255,255,255,.06); color:#cdd6f4; }
.modal-item:active { background:rgba(255,255,255,.06); }
.modal-row { display:flex; align-items:center; justify-content:center; gap:20rpx; margin:16rpx 0; color:#cdd6f4; font-size:28rpx; }
.swatches { display:flex; flex-wrap:wrap; gap:12rpx; justify-content:center; }
.swatch { width:64rpx; height:64rpx; border-radius:50%; border:2px solid rgba(255,255,255,.15); }
