.editor-root { width:100vw; height:100vh; overflow:hidden; background:#000; }
.editor-canvas { position:absolute; top:0; left:0; width:100%; height:100%; }

.cv-top { position:absolute; top:0; left:0; right:0; z-index:10; background:rgba(0,0,0,.75); padding:8rpx 16rpx; padding-top:calc(8rpx + env(safe-area-inset-top)); }
.cv-bottom { position:absolute; bottom:0; left:0; right:0; z-index:10; background:rgba(0,0,0,.75); padding:8rpx 16rpx; padding-bottom:calc(8rpx + env(safe-area-inset-bottom)); }
.cv-row { display:flex; align-items:center; gap:8rpx; flex-wrap:wrap; justify-content:center; }
.cv-btn { color:#fff; font-size:26rpx; padding:10rpx 16rpx; border-radius:8rpx; background:rgba(255,255,255,.15); white-space:nowrap; min-width:50rpx; text-align:center; }
.cv-label { color:rgba(255,255,255,.8); font-size:24rpx; min-width:100rpx; text-align:center; }

.cv-modal { position:fixed; top:0; left:0; width:100%; height:100%; z-index:100; background:rgba(0,0,0,.5); display:flex; align-items:center; justify-content:center; }
.cv-card { background:#fff; border-radius:16rpx; padding:32rpx; width:600rpx; max-height:80vh; overflow-y:auto; }
.cv-title { font-weight:900; font-size:32rpx; margin-bottom:24rpx; text-align:center; }
.cv-field { display:flex; align-items:center; gap:16rpx; margin:16rpx 0; }
.cv-label { font-size:26rpx; font-weight:650; }
.cv-swatch { width:56rpx; height:56rpx; border-radius:50%; border:2px solid #e5e7eb; display:inline-block; margin:8rpx; }
.cv-font-item { font-size:28rpx; padding:16rpx; border-bottom:1px solid #f5f5f5; }
