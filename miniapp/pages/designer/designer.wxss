page { background:#f8fafc; color:#0f172a; height:100%; }
.page { display:flex; flex-direction:column; height:100vh; }

.bar { display:flex; align-items:center; gap:10rpx; padding:14rpx 20rpx; flex-wrap:wrap; background:#fff; }
.top-bar { border-bottom:1px solid #f1f5f9; padding-top:calc(14rpx + env(safe-area-inset-top)); }
.bottom-bar { border-top:1px solid #f1f5f9; padding-bottom:calc(14rpx + env(safe-area-inset-bottom)); justify-content:center; }

.btn {
  border:1px solid #e2e8f0; background:#fff; color:#334155; border-radius:999px;
  padding:12rpx 22rpx; font-size:22rpx; font-weight:600; line-height:1;
  white-space:nowrap; margin:0; transition:all .15s;
}
.btn:active { background:#f1f5f9; border-color:#cbd5e1; }
.btn.pri { background:#0f172a; border-color:#0f172a; color:#fff; }
.btn.pri:active { background:#334155; }

.info { font-size:22rpx; color:#64748b; margin:0 8rpx; white-space:nowrap; font-weight:600; }

.canvas-area { flex:1; display:flex; align-items:center; justify-content:center; overflow:hidden; background:#f1f5f9; }
.ec { width:100%; height:100%; }

.modal { position:fixed; top:0; left:0; width:100%; height:100%; z-index:100; background:rgba(15,23,42,.4); display:flex; align-items:center; justify-content:center; }
.modal-card { background:#fff; border-radius:24rpx; padding:36rpx 32rpx; width:640rpx; max-height:80vh; overflow-y:auto; box-shadow:0 20px 60px rgba(0,0,0,.15); }
.modal-title { font-weight:900; font-size:30rpx; margin-bottom:20rpx; text-align:center; color:#0f172a; }
.modal-item { font-size:28rpx; padding:18rpx 24rpx; border-bottom:1px solid #f5f5f5; color:#334155; }
.modal-item:active { background:#f8fafc; }
.modal-row { display:flex; align-items:center; justify-content:center; gap:24rpx; margin:16rpx 0; color:#334155; font-size:28rpx; font-weight:600; }
.swatches { display:flex; flex-wrap:wrap; gap:14rpx; justify-content:center; }
.swatch { width:64rpx; height:64rpx; border-radius:50%; border:2px solid #e2e8f0; }
.swatch:active { border-color:#6366f1; transform:scale(1.1); }
