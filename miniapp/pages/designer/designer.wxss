.designer-view { min-height:100vh; background:#fff; display:flex; flex-direction:column; }
.designer-top { display:flex; align-items:center; justify-content:space-between; padding:20rpx 24rpx; border-bottom:1px solid #f1f5f9; }
.designer-brand { font-weight:950; font-size:30rpx; color:#111827; }

.panel { flex:1; padding:24rpx; overflow:hidden; display:flex; flex-direction:column; }

.setup-row { display:flex; flex-direction:column; gap:28rpx; }
.control { display:flex; flex-direction:column; gap:8rpx; }
.control-label { font-weight:700; font-size:26rpx; color:#475569; }
.control-input { border:1px solid #e5e7eb; border-radius:14rpx; padding:18rpx 20rpx; font-size:28rpx; background:#fafafa; }
.ratio-group { display:flex; gap:14rpx; flex-wrap:wrap; }
.ratio-opt { border:1px solid #e5e7eb; border-radius:14rpx; padding:14rpx 24rpx; font-size:26rpx; font-weight:650; }
.ratio-opt.active { background:#111827; color:#fff; border-color:#111827; }
.setup-actions { margin-top:36rpx; text-align:center; }

.editor-panel { padding:14rpx; gap:10rpx; }
.editor-nav { display:flex; align-items:center; justify-content:center; gap:16rpx; }
.page-indicator { font-weight:700; font-size:26rpx; min-width:100rpx; text-align:center; }

.toolbar { display:flex; gap:8rpx; flex-wrap:wrap; justify-content:center; }
.tb { display:inline-block; padding:8rpx 16rpx; font-size:24rpx; border:1px solid #e2e8f0; border-radius:999px; background:#fff; color:#334155; font-weight:600; line-height:1.2; }
.tb:active { background:#f1f5f9; }
.tb-red { border-color:#fecaca; color:#ef4444; }

.canvas-wrap { flex:1; display:flex; align-items:center; justify-content:center; background:#f8fafc; border-radius:18rpx; overflow:hidden; min-height:400rpx; }
.zine-canvas { border:1px solid #e5e7eb; border-radius:8rpx; background:#fff; box-shadow:0 4px 24px rgba(15,23,42,.06); }

.style-bar { display:flex; align-items:center; justify-content:center; gap:16rpx; padding:8rpx 0; flex-wrap:wrap; }
.style-pick { font-size:22rpx; color:#4f46e5; font-weight:650; border:1px solid #e5e7eb; border-radius:10rpx; padding:6rpx 12rpx; }
.style-label { font-size:20rpx; color:#64748b; }
.style-val { font-size:22rpx; color:#475569; }
.color-dot { width:36rpx; height:36rpx; border-radius:50%; border:2px solid #e2e8f0; flex-shrink:0; }

.editor-actions { text-align:center; margin-top:4rpx; }

.color-modal { position:fixed; top:0; left:0; width:100%; height:100%; z-index:9999; background:rgba(0,0,0,.5); display:flex; align-items:center; justify-content:center; }
.color-card { background:#fff; border-radius:24rpx; padding:36rpx; width:580rpx; display:flex; flex-direction:column; align-items:center; box-shadow:0 20px 60px rgba(0,0,0,.2); }
.color-title { font-weight:900; font-size:30rpx; margin-bottom:24rpx; }
.color-swatches { display:flex; flex-wrap:wrap; gap:14rpx; justify-content:center; }
.color-swatch { width:64rpx; height:64rpx; border-radius:50%; border:2px solid #e2e8f0; }
