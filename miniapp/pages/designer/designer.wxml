<!-- 全屏编辑器 -->
<view class="editor-root">
  <canvas
    type="2d"
    id="ec"
    class="editor-canvas"
    bindtouchstart="onTS" bindtouchmove="onTM" bindtouchend="onTE" bindtap="onTap"
  >
    <cover-view class="cv-top">
      <cover-view class="cv-row">
        <cover-view class="cv-btn" bindtap="onBack">←</cover-view>
        <cover-view class="cv-btn" bindtap="onAddText">T</cover-view>
        <cover-view class="cv-btn" bindtap="onAddImg">+</cover-view>
        <cover-view class="cv-btn" bindtap="onDel">×</cover-view>
        <cover-view class="cv-btn" bindtap="onUndo">↩</cover-view>
        <cover-view class="cv-label">{{pageInfo}}</cover-view>
        <cover-view class="cv-btn" bindtap="onPrev">◀</cover-view>
        <cover-view class="cv-btn" bindtap="onNext">▶</cover-view>
        <cover-view class="cv-btn" bindtap="onGrid">{{gridOn ? '#' : '⊞'}}</cover-view>
        <cover-view class="cv-btn" bindtap="onSave">✓</cover-view>
      </cover-view>
    </cover-view>

    <cover-view class="cv-bottom" wx:if="{{activeObj}}">
      <cover-view class="cv-row">
        <cover-view class="cv-btn" bindtap="onFontDown">A-</cover-view>
        <cover-view class="cv-btn" bindtap="onFontUp">A+</cover-view>
        <cover-view class="cv-btn" bindtap="onFontPick">字体</cover-view>
        <cover-view class="cv-btn" bindtap="onColorPick">色</cover-view>
        <cover-view class="cv-btn" bindtap="onScaleDown">-</cover-view>
        <cover-view class="cv-btn" bindtap="onScaleUp">+</cover-view>
        <cover-view class="cv-btn" bindtap="onMoveUp">↑</cover-view>
        <cover-view class="cv-btn" bindtap="onMoveDown">↓</cover-view>
      </cover-view>
      <cover-view class="cv-row">
        <cover-view class="cv-btn" bindtap="onMoveLeft">←</cover-view>
        <cover-view class="cv-btn" bindtap="onMoveRight">→</cover-view>
        <cover-view class="cv-btn" bindtap="onBgPick">背景</cover-view>
        <cover-view class="cv-btn" bindtap="onSnapOn">{{snapOn ? '吸附开' : '吸附关'}}</cover-view>
      </cover-view>
    </cover-view>
  </canvas>

  <!-- 网格设置弹窗 -->
  <cover-view class="cv-modal" wx:if="{{showGridModal}}">
    <cover-view class="cv-card">
      <cover-view class="cv-title">网格设置</cover-view>
      <cover-view class="cv-field">
        <cover-view class="cv-label">网格大小</cover-view>
        <slider min="10" max="100" value="{{gridSize}}" bindchange="onGridSize" show-value />
      </cover-view>
      <cover-view class="cv-field">
        <cover-view class="cv-label">网格颜色</cover-view>
        <cover-view class="cv-swatch" style="background:{{gridColor}}" bindtap="onGridColor"></cover-view>
      </cover-view>
      <cover-view class="cv-btn" bindtap="onGridClose">关闭</cover-view>
    </cover-view>
  </cover-view>

  <!-- 颜色选择 -->
  <cover-view class="cv-modal" wx:if="{{showColor}}">
    <cover-view class="cv-card">
      <cover-view class="cv-title">选择颜色</cover-view>
      <cover-view wx:for="{{palette}}" wx:key="*this" class="cv-swatch" style="background:{{item}}" bindtap="onPickColor" data-color="{{item}}"></cover-view>
      <cover-view class="cv-btn" bindtap="onColorClose">关闭</cover-view>
    </cover-view>
  </cover-view>

  <!-- 字体选择 -->
  <cover-view class="cv-modal" wx:if="{{showFonts}}">
    <cover-view class="cv-card">
      <cover-view class="cv-title">选择字体</cover-view>
      <cover-view wx:for="{{fontList}}" wx:key="*this" class="cv-font-item" bindtap="onPickFont" data-font="{{item}}">{{item}}</cover-view>
      <cover-view class="cv-btn" bindtap="onFontClose">关闭</cover-view>
    </cover-view>
  </cover-view>
</view>
