<block>
<!-- 设计器 -->
<view class="designer-view">
  <view class="designer-top">
    <text class="designer-brand">自由ZINE</text>
    <button class="circle-btn small" bindtap="onBackHome">主页</button>
  </view>

  <!-- 设置面板 -->
  <view class="panel setup-panel {{editorVisible ? 'hidden' : ''}}">
    <view class="setup-row">
      <view class="control">
        <text class="control-label">书籍名称</text>
        <input class="control-input" value="{{bookTitle}}" bindinput="onTitleInput" maxlength="40" placeholder="输入书名" />
      </view>
      <view class="control">
        <text class="control-label">空白页数量</text>
        <input class="control-input" type="number" value="{{pageCount}}" bindinput="onPageCountInput" placeholder="1-36" />
      </view>
      <view class="control">
        <text class="control-label">页面比例</text>
        <view class="ratio-group">
          <label class="ratio-opt {{ratio === '1:1' ? 'active' : ''}}" bindtap="onRatioTap" data-v="1:1"><text>1:1</text></label>
          <label class="ratio-opt {{ratio === '5:4' ? 'active' : ''}}" bindtap="onRatioTap" data-v="5:4"><text>5:4</text></label>
          <label class="ratio-opt {{ratio === '3:2' ? 'active' : ''}}" bindtap="onRatioTap" data-v="3:2"><text>3:2</text></label>
          <label class="ratio-opt {{ratio === '4:5' ? 'active' : ''}}" bindtap="onRatioTap" data-v="4:5"><text>4:5</text></label>
          <label class="ratio-opt {{ratio === '2:3' ? 'active' : ''}}" bindtap="onRatioTap" data-v="2:3"><text>2:3</text></label>
        </view>
      </view>
    </view>
    <view class="setup-actions">
      <button class="circle-btn primary" bindtap="onStart">生成并开始制作</button>
    </view>
  </view>

  <!-- 编辑面板 -->
  <view class="panel editor-panel {{editorVisible ? '' : 'hidden'}}">
    <!-- 导航 -->
    <view class="editor-nav">
      <button class="circle-btn small" bindtap="onPrevPage">◀</button>
      <text class="page-indicator">{{curPage+1}}/{{pageCount}}</text>
      <button class="circle-btn small" bindtap="onNextPage">▶</button>
    </view>

    <!-- 工具栏 -->
    <view class="toolbar">
      <button class="tb-btn" bindtap="onAddText">文字</button>
      <button class="tb-btn" bindtap="onAddImage">图片</button>
      <button class="tb-btn" bindtap="onDelActive">删除</button>
      <button class="tb-btn danger" bindtap="onClearPage">清空</button>
    </view>

    <view class="canvas-wrap">
      <canvas type="2d" id="zineCanvas" class="zine-canvas"
        style="width:{{canvasStyleW}}px;height:{{canvasStyleH}}px;"
        disable-scroll="true"
        catchtouchstart="onTS" catchtouchmove="onTM" catchtouchend="onTE"
      ></canvas>
    </view>

    <!-- 样式控制：紧凑单行 -->
    <view class="style-bar">
      <picker value="{{fontFamilyIdx}}" range="{{fontFamilies}}" bindchange="onFontPick">
        <text class="style-pick">{{fontFamilies[fontFamilyIdx]}}</text>
      </picker>
      <view class="color-dot" style="background:{{fontColor}}" bindtap="onFontColorTap"></view>
      <text class="style-label">字色</text>
      <view class="color-dot" style="background:{{bgColor}}" bindtap="onBgColorTap"></view>
      <text class="style-label">背景</text>
      <text class="style-val" wx:if="{{activeObj}}">{{activeObjScale}}x</text>
    </view>

    <!-- 操作 -->
    <view class="editor-actions">
      <button class="circle-btn primary" bindtap="onFinish">完成并封装成图标</button>
      <text class="status">{{status}}</text>
    </view>
  </view>
</view>

<!-- 颜色弹窗 -->
<view class="color-modal" wx:if="{{showColor}}" catchtap="onColorClose">
  <view class="color-card" catchtap="noop">
    <text class="color-title">选择颜色</text>
    <view class="color-swatches">
      <view wx:for="{{colorPalette}}" wx:key="*this" class="color-swatch" style="background:{{item}}" bindtap="onPickColor" data-color="{{item}}"></view>
    </view>
    <button class="circle-btn small" bindtap="onColorClose">关闭</button>
  </view>
</view>
</block>
